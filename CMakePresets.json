{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build-${presetName}/install-${presetName}",
        "BUILD_TESTING": "OFF"
      }
    },

    {
      "name": "release-gcc",
      "displayName": "Release (GCC, static runtime)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_HOST_OPT": "OFF",
        "BUILD_DOCS": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_CXX_FLAGS": "-O2 -march=skylake ",
        "CMAKE_C_FLAGS": "-O2 -march=x86-64-v3 "
      }
    },

    {
      "name": "release-gcc-testing",
      "displayName": "Release (GCC, static runtime) + tests",
      "inherits": "release-gcc",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "debug-gcc",
      "displayName": "Debug (GCC)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_HOST_OPT": "OFF",
        "BUILD_DOCS": "OFF",
        "CMAKE_CXX_FLAGS": "-O0 -g3 -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-O0 -g3 -fno-omit-frame-pointer"
      }
    },

    {
      "name": "debug-gcc-testing",
      "displayName": "Debug (GCC) + tests",
      "inherits": "debug-gcc",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "release-clang",
      "displayName": "Release (Clang, static runtime)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_HOST_OPT": "OFF",
        "WITH_LLD": "ON",
        "BUILD_DOCS": "ON",
        "CMAKE_CXX_FLAGS": "-O2 -march=skylake -static-libgcc -static-libstdc++",
        "CMAKE_C_FLAGS": "-O2 -march=x86-64-v3 -static-libgcc"
      }
    },

    {
      "name": "release-clang-testing",
      "displayName": "Release (Clang, static runtime) + tests",
      "inherits": "release-clang",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "debug-clang",
      "displayName": "Debug (Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_HOST_OPT": "OFF",
        "WITH_LLD": "ON",
        "BUILD_DOCS": "OFF",
        "CMAKE_CXX_FLAGS": "-O0 -g3 -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-O0 -g3 -fno-omit-frame-pointer"
      }
    },

    {
      "name": "debug-clang-testing",
      "displayName": "Debug (Clang) + tests",
      "inherits": "debug-clang",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },

    {
      "name": "windows-mingw",
      "displayName": "Release (Windows, MinGW-w64, static)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "ENABLE_HOST_OPT": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "USE_OPENMP": "OFF",
        "CPACK_SYSTEM_NAME": "windows",
        "GG_NO_PRAGMA": "ON",
        "CMAKE_CXX_FLAGS": "-O2 -static -static-libgcc -static-libstdc++",
        "CMAKE_C_FLAGS": "-O2 -static -static-libgcc -static-libstdc++",
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++"
      }
    },

    {
      "name": "windows-msvc",
      "displayName": "Release (MSVC, static)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
       "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER": "lld-link",
        "ENABLE_HOST_OPT": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "USE_OPENMP": "OFF",
        "CPACK_SYSTEM_NAME": "windows",
        "DCMAKE_GENERATOR_x86_64_pc_windows_msvc":"Ninja",
        "BUILD_SHARED_TBB":"ON",
        "GG_NO_PRAGMA": "ON",
        "BUILD_TESTING": "ON",
        "BUILD_FPIC": "ON",
        "WITH_PYTHON_BINDINGS": "OFF"
      }
    },

    {
      "name": "debug-msvc",
      "displayName": "Debug (MSVC, static)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_LINKER": "lld-link",
        "ENABLE_HOST_OPT": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "USE_OPENMP": "OFF",
        "CPACK_SYSTEM_NAME": "windows",
        "DCMAKE_GENERATOR_x86_64_pc_windows_msvc":"Ninja",
        "BUILD_SHARED_TBB":"ON",
        "GG_NO_PRAGMA": "ON",
        "BUILD_TESTING": "ON",
        "BUILD_FPIC": "ON",
        "WITH_PYTHON_BINDINGS": "OFF"
      }
    },

    {
      "name": "relwithdebinfo-gcc",
      "displayName": "RelWithDebInfo (GCC, symbols + -O2)",
      "inherits": "release-gcc-testing",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O2 -march=skylake -g -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-O2 -march=x86-64-v3 -g -fno-omit-frame-pointer"
      }
    },

    {
      "name": "relwithdebinfo-clang",
      "displayName": "RelWithDebInfo (Clang, symbols + -O2)",
      "inherits": "release-clang-testing",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_DOCS": "OFF",
        "CMAKE_CXX_FLAGS": "-O2 -march=skylake -g -fno-omit-frame-pointer -static-libgcc -static-libstdc++",
        "CMAKE_C_FLAGS": "-O2 -march=x86-64-v3 -g -fno-omit-frame-pointer -static-libgcc"
      }
    },

    {
      "name": "relwithdebinfo-msvc",
      "displayName": "RelWithDebInfo (MSVC, symbols + /O2 /Ob2)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc",
      "displayName": "Build release-gcc"
    },
    {
      "name": "release-gcc-testing",
      "configurePreset": "release-gcc-testing",
      "displayName": "Build release-gcc-testing"
    },
    {
      "name": "debug-gcc",
      "configurePreset": "debug-gcc",
      "displayName": "Build debug-gcc"
    },
    {
      "name": "debug-gcc-testing",
      "configurePreset": "debug-gcc-testing",
      "displayName": "Build debug-gcc-testing"
    },
    {
      "name": "release-clang",
      "configurePreset": "release-clang",
      "displayName": "Build release-clang"
    },
    {
      "name": "release-clang-testing",
      "configurePreset": "release-clang-testing",
      "displayName": "Build release-clang-testing"
    },
    {
      "name": "debug-clang",
      "configurePreset": "debug-clang",
      "displayName": "Build debug-clang"
    },
    {
      "name": "debug-clang-testing",
      "configurePreset": "debug-clang-testing",
      "displayName": "Build debug-clang-testing"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "displayName": "Build windows-mingw"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "displayName": "Build windows-msvc"
    },
    {
      "name": "debug-msvc",
      "configurePreset": "debug-msvc",
      "displayName": "Build debug-msvc"
    },
    {
      "name": "relwithdebinfo-gcc",
      "configurePreset": "relwithdebinfo-gcc",
      "displayName": "Build relwithdebinfo-gcc"
    },
    {
      "name": "relwithdebinfo-clang",
      "configurePreset": "relwithdebinfo-clang",
      "displayName": "Build relwithdebinfo-clang"
    },
    {
      "name": "relwithdebinfo-msvc",
      "configurePreset": "relwithdebinfo-msvc",
      "displayName": "Build relwithdebinfo-msvc"
    }
  ],

  "testPresets": [
    {
      "name": "release-gcc-testing",
      "configurePreset": "release-gcc-testing",
      "displayName": "Test release-gcc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug-gcc-testing",
      "configurePreset": "debug-gcc-testing",
      "displayName": "Test debug-gcc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "release-clang-testing",
      "configurePreset": "release-clang-testing",
      "displayName": "Test release-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug-clang-testing",
      "configurePreset": "debug-clang-testing",
      "displayName": "Test debug-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "displayName": "Test windows-msvc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug-msvc",
      "configurePreset": "debug-msvc",
      "displayName": "Test debug-msvc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "relwithdebinfo-gcc",
      "configurePreset": "relwithdebinfo-gcc",
      "displayName": "Test relwithdebinfo-gcc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "relwithdebinfo-clang",
      "configurePreset": "relwithdebinfo-clang",
      "displayName": "Test relwithdebinfo-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "relwithdebinfo-msvc",
      "configurePreset": "relwithdebinfo-msvc",
      "displayName": "Test relwithdebinfo-msvc",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    }
  ],

  "workflowPresets": [
